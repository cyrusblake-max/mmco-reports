# --- AI features (screenshot extraction + report writing) -------------------
# Required for /api/extract and /api/write. Server-side only — never exposed
# to the browser. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides (default: claude-sonnet-4-6)
# ANTHROPIC_EXTRACT_MODEL=claude-sonnet-4-6
# ANTHROPIC_WRITE_MODEL=claude-sonnet-4-6

# --- Shared storage (multi-device sync) -------------------------------------
# Optional. Without these, reports live in each browser's localStorage.
# See SUPABASE.md for setup.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# --- Misc -------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=mmco-reports.vercel.app
